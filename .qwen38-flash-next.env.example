# Copy to .qwen38-flash-next.env and set HF_TOKEN before the first run.
# This file is sourced by Bash. Quote values that contain spaces or JSON.
HF_TOKEN=''

# Model
MODEL_ID='RadixArk/Qwen3.8-Flash-Next-NVFP4'
SERVED_MODEL_NAME='qwen3.8-flash-next'
ALLOW_CUSTOM_MODEL_ID=0
DOWNLOAD_MODEL=1

# Memory and request limits
MAX_MODEL_LEN=65536
MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.78
KV_CACHE_DTYPE='bfloat16'
MTP_SPECULATIVE_TOKENS=2
PLE_MMAP_WORKERS=32
PLE_MMAP_PREWARM=0

# Network. The proxy has no access control. Use a trusted network.
PUBLIC_HOST='0.0.0.0'
PUBLIC_PORT=1234
VLLM_HOST='127.0.0.1'
VLLM_PORT=8000
CONTAINER_NAME='qwen38-flash-vllm'

# Storage. Use absolute paths for Docker bind mounts.
# PWD is the directory from which you start the launcher.
HF_HOME="${HOME}/.cache/huggingface"
WORKDIR="${PWD}/qwen38-flash-spark"
FLASHINFER_CACHE_HOST="${WORKDIR}/flashinfer-cache"

# Build. Set REBUILD_VLLM_IMAGE=1 for a forced rebuild, then reset it to 0.
QWEN38_VLLM_IMAGE='qwen38-flash-dgx'
RECIPE_REPO_URL='https://github.com/blazux/qwen3.8-Flash-DGX.git'
RECIPE_REF='main'
RECIPE_DIR="${WORKDIR}/qwen3.8-Flash-DGX"
REBUILD_VLLM_IMAGE=0

# Startup. Set RESTART_VLLM=0 to keep the loaded model and restart the proxy.
RESTART_VLLM=1
VLLM_ENGINE_READY_TIMEOUT_S=1800
STARTUP_WAIT_SECONDS=2400

# Chat behavior
ENABLE_REASONING_PARSER=1
REASONING_PARSER='qwen3'
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER='qwen3_coder'
DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
